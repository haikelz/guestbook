  "narrative": {
    "northStar": "Open House",
    "overview": "Open House makes personal conversation feel welcoming and moderation feel clear. Blue provides a recognizable point of arrival; neutral surfaces carry reading, searching, and decisions. The self-hosted Geist family and familiar HeroUI v3 controls connect the public guestbook and administrator workspace.\n\nDensity follows the task: generous message spacing supports reading, while aligned rows and compact metadata support moderation. Theme changes preserve these relationships through semantic CSS variables. The implemented identity uses typography, tone, and borders without decorative imagery.",
    "keyCharacteristics": [
      "Blue welcome surface and neutral reading areas.",
      "Flat, separated content with restrained rounded containers.",
      "One type family with clear headings and quiet metadata.",
      "Responsive records and explicit destructive actions."
    ],
    "rules": [
      {
        "name": "The Semantic Theme Rule",
        "body": "Use the shared semantic variables so both themes preserve the same hierarchy.",
